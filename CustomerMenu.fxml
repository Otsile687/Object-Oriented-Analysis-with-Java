<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" 
            prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/8" 
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="DebugCustomerMenuController" 
            style="-fx-background-color: #dbeafe;">
   
   <children>
      <!-- Header -->
      <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#1e3a8a" height="60.0" layoutX="0.0" 
                 layoutY="0.0" stroke="BLACK" strokeType="INSIDE" width="800.0" />
      
      <Label layoutX="280.0" layoutY="15.0" text="CUSTOMER DASHBOARD" textFill="WHITE">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      
      <!-- Side Menu -->
      <Rectangle arcHeight="10.0" arcWidth="10.0" fill="WHITE" height="450.0" layoutX="20.0" 
                 layoutY="80.0" stroke="#1e3a8a" strokeWidth="1.0" width="180.0" />
      
      <!-- Customer Menu Buttons -->
      <Button fx:id="checkBalanceButton" layoutX="35.0" layoutY="100.0" mnemonicParsing="false" 
              prefHeight="35.0" prefWidth="150.0" text="Check Balance" onAction="#handleCheckBalance" 
              style="-fx-background-color: #1e3a8a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" />
      
      <Button fx:id="withdrawButton" layoutX="35.0" layoutY="150.0" mnemonicParsing="false" 
              prefHeight="35.0" prefWidth="150.0" text="Withdraw" onAction="#handleWithdraw" 
              style="-fx-background-color: #1e3a8a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" />
      
      <Button fx:id="depositButton" layoutX="35.0" layoutY="200.0" mnemonicParsing="false" 
              prefHeight="35.0" prefWidth="150.0" text="Deposit" onAction="#handleDeposit" 
              style="-fx-background-color: #1e3a8a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" />
      
      <Button fx:id="transactionHistoryButton" layoutX="35.0" layoutY="250.0" mnemonicParsing="false" 
              prefHeight="35.0" prefWidth="150.0" text="Transaction History" onAction="#handleTransactionHistory" 
              style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" />
      
      <Button fx:id="logoutButton" layoutX="35.0" layoutY="400.0" mnemonicParsing="false" 
              prefHeight="35.0" prefWidth="150.0" text="Logout" onAction="#handleLogout" 
              style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" />
      
      <!-- Transaction History Section -->
      <Rectangle arcHeight="10.0" arcWidth="10.0" fill="WHITE" height="400.0" layoutX="220.0" 
                 layoutY="80.0" stroke="#1e3a8a" strokeWidth="1.0" width="560.0" />
      
      <Label layoutX="240.0" layoutY="95.0" text="Transaction History" textFill="#1e3a8a">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Label>
      
      <ListView fx:id="transactionListView" layoutX="240.0" layoutY="120.0" prefHeight="300.0" 
                prefWidth="520.0" 
                style="-fx-border-color: #1e3a8a; -fx-border-radius: 5; -fx-background-radius: 5;" />
      
      <!-- Account Summary -->
      <Label layoutX="240.0" layoutY="440.0" text="Welcome to your banking dashboard!" 
             style="-fx-text-fill: #374151; -fx-font-size: 14;" />
   </children>
</AnchorPane>