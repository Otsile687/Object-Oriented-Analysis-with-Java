<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" 
            prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/8" 
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="BankLoginController" 
            style="-fx-background-color: #dbeafe;">
   
   <children>
      <!-- Header Background -->
      <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#1e3a8a" height="80.0" layoutX="200.0" 
                 layoutY="50.0" stroke="BLACK" strokeType="INSIDE" width="400.0" />
      
      <!-- Title -->
      <Label layoutX="250.0" layoutY="70.0" text="OTS BANK SYSTEM" textFill="WHITE">
         <font>
            <Font name="System Bold" size="28.0" />
         </font>
      </Label>
      
      <!-- Login Box -->
      <Rectangle arcHeight="10.0" arcWidth="10.0" fill="WHITE" height="350.0" layoutX="200.0" 
                 layoutY="150.0" stroke="#1e3a8a" strokeWidth="2.0" width="400.0" />
      
      <!-- Login Form -->
      <Label layoutX="250.0" layoutY="190.0" text="User ID:" textFill="#374151" />
      <TextField fx:id="userIdField" layoutX="320.0" layoutY="186.0" prefHeight="30.0" 
                 prefWidth="200.0" promptText="Enter user ID" 
                 style="-fx-border-color: #1e3a8a; -fx-border-radius: 5; -fx-background-radius: 5;" />
      
      <Label layoutX="230.0" layoutY="240.0" text="Password:" textFill="#374151" />
      <PasswordField fx:id="passwordField" layoutX="320.0" layoutY="236.0" prefHeight="30.0" 
                     prefWidth="200.0" promptText="Enter password" 
                     style="-fx-border-color: #1e3a8a; -fx-border-radius: 5; -fx-background-radius: 5;" />
      
      <!-- Buttons -->
      <Button fx:id="customerLoginButton" layoutX="250.0" layoutY="300.0" mnemonicParsing="false" 
              prefHeight="35.0" prefWidth="120.0" text="Customer Login" 
              onAction="#handleCustomerLogin" 
              style="-fx-background-color: #1e3a8a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" />
      
      <Button fx:id="employeeLoginButton" layoutX="390.0" layoutY="300.0" mnemonicParsing="false" 
              prefHeight="35.0" prefWidth="120.0" text="Employee Login" 
              onAction="#handleEmployeeLogin" 
              style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" />
      
      <Button fx:id="exitButton" layoutX="320.0" layoutY="350.0" mnemonicParsing="false" 
              prefHeight="35.0" prefWidth="120.0" text="Exit" onAction="#handleExit" 
              style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" />
      
      <!-- Footer -->
      <Label layoutX="300.0" layoutY="500.0" text="Secure Banking System" textFill="#1e3a8a">
         <font>
            <Font name="System Italic" size="12.0" />
         </font>
      </Label>
   </children>
</AnchorPane>