<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" 
            prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/8" 
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="EmployeeMenuController" 
            style="-fx-background-color: #dbeafe;">
   
   <children>
      <!-- Header -->
      <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#1e3a8a" height="60.0" layoutX="0.0" 
                 layoutY="0.0" stroke="BLACK" strokeType="INSIDE" width="800.0" />
      
      <Label layoutX="300.0" layoutY="15.0" text="EMPLOYEE DASHBOARD" textFill="WHITE">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      
      <!-- Side Menu -->
      <Rectangle arcHeight="10.0" arcWidth="10.0" fill="WHITE" height="450.0" layoutX="20.0" 
                 layoutY="80.0" stroke="#1e3a8a" strokeWidth="1.0" width="180.0" />
      
      <Button fx:id="addCustomerButton" layoutX="35.0" layoutY="100.0" mnemonicParsing="false" 
              prefHeight="35.0" prefWidth="150.0" text="Add Customer" onAction="#handleAddCustomer" 
              style="-fx-background-color: #1e3a8a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" />
      
      <Button fx:id="openAccountButton" layoutX="35.0" layoutY="150.0" mnemonicParsing="false" 
              prefHeight="35.0" prefWidth="150.0" text="Open Account" onAction="#handleOpenAccount" 
              style="-fx-background-color: #1e3a8a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" />
      
      <Button fx:id="closeAccountButton" layoutX="35.0" layoutY="200.0" mnemonicParsing="false" 
              prefHeight="35.0" prefWidth="150.0" text="Close Account" onAction="#handleCloseAccount" 
              style="-fx-background-color: #1e3a8a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" />
      
      <Button fx:id="deleteCustomerButton" layoutX="35.0" layoutY="250.0" mnemonicParsing="false" 
              prefHeight="35.0" prefWidth="150.0" text="Delete Customer" onAction="#handleDeleteCustomer" 
              style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" />
      
      <Button fx:id="viewCustomersButton" layoutX="35.0" layoutY="300.0" mnemonicParsing="false" 
              prefHeight="35.0" prefWidth="150.0" text="View Customers" onAction="#handleViewCustomers" 
              style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" />
      
      <Button fx:id="logoutButton" layoutX="35.0" layoutY="400.0" mnemonicParsing="false" 
              prefHeight="35.0" prefWidth="150.0" text="Logout" onAction="#handleLogout" 
              style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" />
      
      <!-- Customer List Section -->
      <Rectangle arcHeight="10.0" arcWidth="10.0" fill="WHITE" height="400.0" layoutX="220.0" 
                 layoutY="80.0" stroke="#1e3a8a" strokeWidth="1.0" width="560.0" />
      
      <Label layoutX="240.0" layoutY="95.0" text="Customer List" textFill="#1e3a8a">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Label>
      
      <ListView fx:id="customerListView" layoutX="240.0" layoutY="120.0" prefHeight="300.0" 
                prefWidth="520.0" 
                style="-fx-border-color: #1e3a8a; -fx-border-radius: 5; -fx-background-radius: 5;" />
      
      <TextField fx:id="searchField" layoutX="240.0" layoutY="440.0" prefHeight="30.0" 
                 prefWidth="400.0" promptText="Search customers..." 
                 style="-fx-border-color: #1e3a8a; -fx-border-radius: 5; -fx-background-radius: 5;" />
   </children>
</AnchorPane>