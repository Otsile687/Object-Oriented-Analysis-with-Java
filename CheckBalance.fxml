<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" 
            prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/8" 
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="CheckBalanceController" 
            style="-fx-background-color: #dbeafe;">
   
   <children>
      <!-- Header -->
      <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#1e3a8a" height="60.0" layoutX="0.0" 
                 layoutY="0.0" stroke="BLACK" strokeType="INSIDE" width="800.0" />
      
      <Label layoutX="280.0" layoutY="15.0" text="CHECK BALANCE" textFill="WHITE">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      
      <!-- Form Container -->
      <Rectangle arcHeight="10.0" arcWidth="10.0" fill="WHITE" height="300.0" layoutX="100.0" 
                 layoutY="120.0" stroke="#1e3a8a" strokeWidth="1.0" width="600.0" />
      
      <!-- Form Fields -->
      <Label layoutX="150.0" layoutY="150.0" text="Account Type:" textFill="#374151" />
      <ComboBox fx:id="accountTypeComboBox" layoutX="270.0" layoutY="146.0" prefWidth="200.0" 
                promptText="Select account type" 
                style="-fx-border-color: #1e3a8a; -fx-border-radius: 5; -fx-background-radius: 5;" />
      
      <Label layoutX="150.0" layoutY="200.0" text="Account Number:" textFill="#374151" />
      <TextField fx:id="accountNumberField" layoutX="270.0" layoutY="196.0" prefWidth="200.0" 
                 promptText="Enter account number" 
                 style="-fx-border-color: #1e3a8a; -fx-border-radius: 5; -fx-background-radius: 5;" />
      
      <!-- Buttons -->
      <Button fx:id="checkBalanceButton" layoutX="250.0" layoutY="270.0" mnemonicParsing="false" 
              prefHeight="35.0" prefWidth="120.0" text="Check Balance" onAction="#handleCheckBalance" 
              style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" />
      
      <Button fx:id="backButton" layoutX="400.0" layoutY="270.0" mnemonicParsing="false" 
              prefHeight="35.0" prefWidth="120.0" text="Back to Menu" onAction="#handleBack" 
              style="-fx-background-color: #1e3a8a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" />
      
      <!-- Balance Display -->
      <Label fx:id="balanceLabel" layoutX="150.0" layoutY="350.0" prefWidth="500.0" 
             style="-fx-alignment: center; -fx-text-fill: #1e3a8a; -fx-font-weight: bold; -fx-font-size: 16;" />
   </children>
</AnchorPane>